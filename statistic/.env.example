# Скопируйте в .env и заполните
VIKUNJA_TOKEN=YOUR_API_TOKEN_HERE
VIKUNJA_BASE_URL=https://vikunja.ru
PROJECT_ID=1
TZ=Asia/Yekaterinburg
CACHE_TTL=300
LOG_LEVEL=INFO
# Базовая HTTP-аутентификация дашборда (логин и пароль).
# Если оба поля пустые — аутентификация отключена.
AUTH_USER=
AUTH_PASS=
# Домен/поддомен и порт сервиса для Docker Compose + Traefik
DOMAIN=
SUBDOMAIN=
SERVICE_PORT=8001
