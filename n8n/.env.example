# DOMAIN_NAME and SUBDOMAIN together determine where n8n will be reachable from
# The top level domain to serve from
DOMAIN_NAME=

# The subdomain to serve from
SUBDOMAIN=

# The above example serve n8n at: https://n8n.example.com

# Optional timezone to set which gets used by Cron and other scheduling nodes
# New York is the default value if not set
GENERIC_TIMEZONE=Asia/Yekaterinburg

# The email address to use for the TLS/SSL certificate creation
SSL_EMAIL=

N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
DB_POSTGRESDB_USER=
DB_POSTGRESDB_PASSWORD=
N8N_RUNNERS_AUTH_TOKEN=

# ... ваши существующие переменные ...

# Версия песочницы (можно использовать latest или зафиксировать конкретную версию из релизов n8n-sandbox-service)
N8N_SANDBOX_VERSION=latest

# Секреты для внутренней аутентификации песочницы
SANDBOX_API_KEYS=change-me-api-key
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=change-me-registration-token
SANDBOX_API_RUNNER_API_KEY=change-me-runner-key

# Этот ключ ДОЛЖЕН совпадать с SANDBOX_API_KEYS, чтобы n8n мог общаться с песочницей
N8N_INSTANCE_AI_SANDBOX_API_KEY=change-me-api-key

# Секрет для SearXNG
SEARXNG_SECRET=change-me-searxng-secret

# Внутренний адрес SearXNG для n8n
N8N_INSTANCE_AI_SEARXNG_URL=http://searxng:8080